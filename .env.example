# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENAI_API_KEY: Server-side OpenAI API key for AI itinerary generation (never expose to client).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for interactive itinerary maps.
VITE_GOOGLE_MAPS_API_KEY=""

# Destination Photography API keys (server-side only, never exposed to client).
# UNSPLASH_ACCESS_KEY is the primary destination photography provider.
UNSPLASH_ACCESS_KEY=""
# PEXELS_API_KEY is optional; when unset, the app gracefully uses Unsplash (with open Wikimedia Commons fallback).
PEXELS_API_KEY=""
