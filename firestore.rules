rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string &&
        id.size() >= 1 &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string &&
        data.uid == userId &&
        isValidId(data.uid) &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 320 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBudgetBreakdown(b) {
      return b is map &&
        b.keys().hasAll([
          'accommodation',
          'food',
          'transportation',
          'activities',
          'total',
          'currency',
          'disclaimer'
        ]) &&
        b.keys().hasOnly([
          'accommodation',
          'food',
          'transportation',
          'activities',
          'total',
          'currency',
          'disclaimer'
        ]) &&
        (b.accommodation is int || b.accommodation is float) && b.accommodation >= 0 &&
        (b.food is int || b.food is float) && b.food >= 0 &&
        (b.transportation is int || b.transportation is float) && b.transportation >= 0 &&
        (b.activities is int || b.activities is float) && b.activities >= 0 &&
        (b.total is int || b.total is float) && b.total >= 0 &&
        b.currency in ['INR', 'USD', 'EUR'] &&
        b.disclaimer is string && b.disclaimer.size() <= 500;
    }

    function isValidTrip(data, tripId) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'title',
          'prompt',
          'destination',
          'travelers',
          'durationDays',
          'currency',
          'travelStyle',
          'tripSummary',
          'totalEstimatedBudget',
          'budgetBreakdown',
          'dailyItinerary',
          'attractions',
          'accommodationSuggestions',
          'foodRecommendations',
          'travelTips',
          'suggestedFollowUps',
          'status',
          'aiProvider',
          'language',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'ownerId',
          'title',
          'prompt',
          'destination',
          'startingLocation',
          'departureDate',
          'returnDate',
          'travelers',
          'durationDays',
          'budgetAmount',
          'totalEstimatedBudget',
          'currency',
          'travelStyle',
          'interests',
          'tripSummary',
          'budgetBreakdown',
          'dailyItinerary',
          'attractions',
          'accommodationSuggestions',
          'foodRecommendations',
          'travelTips',
          'suggestedFollowUps',
          'notes',
          'language',
          'status',
          'aiProvider',
          'responseId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string &&
        data.id == tripId &&
        isValidId(data.id) &&
        data.ownerId is string &&
        data.ownerId == request.auth.uid &&
        isValidId(data.ownerId) &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 200 &&
        data.prompt is string &&
        data.prompt.size() >= 1 &&
        data.prompt.size() <= 2000 &&
        data.destination is string &&
        data.destination.size() >= 1 &&
        data.destination.size() <= 200 &&
        (!('startingLocation' in data) || (data.startingLocation is string && data.startingLocation.size() <= 200)) &&
        (!('departureDate' in data) || (data.departureDate is string && data.departureDate.size() <= 20)) &&
        (!('returnDate' in data) || (data.returnDate is string && data.returnDate.size() <= 20)) &&
        data.travelers is int &&
        data.travelers >= 1 &&
        data.travelers <= 30 &&
        data.durationDays is int &&
        data.durationDays >= 1 &&
        data.durationDays <= 30 &&
        (!('budgetAmount' in data) || ((data.budgetAmount is int || data.budgetAmount is float) && data.budgetAmount >= 0)) &&
        (data.totalEstimatedBudget is int || data.totalEstimatedBudget is float) &&
        data.totalEstimatedBudget >= 0 &&
        data.currency in ['INR', 'USD', 'EUR'] &&
        data.travelStyle in ['family', 'solo', 'couple', 'adventure', 'budget', 'luxury'] &&
        (!('interests' in data) || (data.interests is list && data.interests.size() <= 15 && (data.interests.size() == 0 || data.interests[0] is string))) &&
        data.tripSummary is string &&
        data.tripSummary.size() >= 1 &&
        data.tripSummary.size() <= 4000 &&
        isValidBudgetBreakdown(data.budgetBreakdown) &&
        data.dailyItinerary is list &&
        data.dailyItinerary.size() <= 30 &&
        (data.dailyItinerary.size() == 0 || data.dailyItinerary[0] is map) &&
        data.attractions is list &&
        data.attractions.size() <= 30 &&
        (data.attractions.size() == 0 || data.attractions[0] is map) &&
        data.accommodationSuggestions is list &&
        data.accommodationSuggestions.size() <= 15 &&
        (data.accommodationSuggestions.size() == 0 || data.accommodationSuggestions[0] is map) &&
        data.foodRecommendations is list &&
        data.foodRecommendations.size() <= 20 &&
        (data.foodRecommendations.size() == 0 || data.foodRecommendations[0] is map) &&
        data.travelTips is list &&
        data.travelTips.size() <= 20 &&
        (data.travelTips.size() == 0 || data.travelTips[0] is string) &&
        data.suggestedFollowUps is list &&
        data.suggestedFollowUps.size() <= 10 &&
        (data.suggestedFollowUps.size() == 0 || data.suggestedFollowUps[0] is string) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
        data.language in ['en', 'ml'] &&
        data.status in ['draft', 'planned', 'archived'] &&
        data.aiProvider in ['openai'] &&
        (!('responseId' in data) || (data.responseId is string && data.responseId.size() <= 128)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) &&
        isVerifiedUser() &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isVerifiedUser() &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'email',
          'displayName',
          'photoURL',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /trips/{tripId} {
      allow get: if isValidId(tripId) &&
        isSignedIn() &&
        existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(tripId) &&
        isVerifiedUser() &&
        isValidTrip(incoming(), tripId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(tripId) &&
        isVerifiedUser() &&
        existing().ownerId == request.auth.uid &&
        existing().status != 'archived' &&
        isValidTrip(incoming(), tripId) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'prompt',
            'destination',
            'startingLocation',
            'departureDate',
            'returnDate',
            'travelers',
            'durationDays',
            'budgetAmount',
            'totalEstimatedBudget',
            'currency',
            'travelStyle',
            'interests',
            'tripSummary',
            'budgetBreakdown',
            'dailyItinerary',
            'attractions',
            'accommodationSuggestions',
            'foodRecommendations',
            'travelTips',
            'suggestedFollowUps',
            'notes',
            'language',
            'status',
            'responseId',
            'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status',
            'updatedAt'
          ])
        );
      allow delete: if isValidId(tripId) &&
        isVerifiedUser() &&
        existing().ownerId == request.auth.uid;
    }
  }
}
